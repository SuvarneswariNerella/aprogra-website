{
  "collectionName": "components_sections_header_configs",
  "info": {
    "displayName": "Header Config",
    "icon": "layout"
  },
  "options": {},
  "attributes": {
    "siteTitle": {
      "type": "string",
      "default": "Aprogra"
    },
    "displayMode": {
      "type": "enumeration",
      "enum": ["logo_and_text", "logo_only", "text_only"],
      "default": "logo_and_text",
      "required": true
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "logoUrl": {
      "type": "string"
    },
    "navLinks": {
      "type": "component",
      "repeatable": true,
      "component": "elements.nav-link"
    }
  }
}
