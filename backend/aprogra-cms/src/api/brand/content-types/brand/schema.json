{
  "kind": "collectionType",
  "collectionName": "brands",
  "info": {
    "singularName": "brand",
    "pluralName": "brands",
    "displayName": "Partner Brand / Client",
    "description": "Global client & partner brand logos used in scrolling marquees across all pages"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "string",
      "default": "Enterprise SaaS"
    },
    "location": {
      "type": "string",
      "default": "Global"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "logoUrl": {
      "type": "string"
    },
    "websiteUrl": {
      "type": "string"
    },
    "row": {
      "type": "integer",
      "default": 1
    },
    "order": {
      "type": "integer",
      "default": 1
    }
  }
}
