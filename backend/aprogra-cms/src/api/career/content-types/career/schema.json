{
  "kind": "collectionType",
  "collectionName": "careers",
  "info": {
    "singularName": "career",
    "pluralName": "careers",
    "displayName": "Career Role",
    "description": "Job openings and career positions"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "team": {
      "type": "string",
      "required": true
    },
    "location": {
      "type": "string",
      "default": "Remote"
    },
    "type": {
      "type": "string",
      "default": "Full-time"
    },
    "description": {
      "type": "text",
      "required": true
    },
    "tags": {
      "type": "text",
      "description": "Comma-separated list of tech tags or skills"
    },
    "order": {
      "type": "integer",
      "default": 1
    }
  }
}
