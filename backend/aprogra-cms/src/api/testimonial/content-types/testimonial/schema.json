{
  "kind": "collectionType",
  "collectionName": "testimonials",
  "info": {
    "singularName": "testimonial",
    "pluralName": "testimonials",
    "displayName": "Testimonial",
    "description": "Client endorsements, peer reviews, and verified enterprise testimonials"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "authorName": {
      "type": "string",
      "required": true,
      "description": "Full name of the person providing the endorsement"
    },
    "authorRole": {
      "type": "string",
      "description": "Title or position (e.g. Chief Technology Officer, School Principal)"
    },
    "authorCompany": {
      "type": "string",
      "description": "Organization or Institution name"
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ],
      "description": "Portrait headshot or company avatar"
    },
    "quote": {
      "type": "text",
      "required": true,
      "description": "Full quote text"
    },
    "rating": {
      "type": "integer",
      "default": 5,
      "min": 1,
      "max": 5,
      "description": "Star rating out of 5"
    },
    "highlight": {
      "type": "string",
      "description": "Short highlight for the review (e.g. 'Production launch in 6 weeks')"
    },
    "projectTag": {
      "type": "string",
      "description": "Tag classifying the project (e.g. 'Cloud Architecture & Kubernetes')"
    },
    "relatedProducts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "inversedBy": "relatedTestimonials"
    }
  }
}
