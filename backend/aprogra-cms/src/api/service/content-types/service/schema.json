{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service & Feature Discipline",
    "description": "Dynamic engineering disciplines, flip cards, and feature showcase tabs on the Services page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "tabLabel": {
      "type": "string",
      "default": "Discipline"
    },
    "title": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "string",
      "default": "Core Engineering"
    },
    "shortSummary": {
      "type": "text"
    },
    "description": {
      "type": "text"
    },
    "icon": {
      "type": "string",
      "default": "web"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "imageUrl": {
      "type": "string"
    },
    "cardOrder": {
      "type": "integer",
      "default": 1
    },
    "kpiNumber": {
      "type": "string"
    },
    "kpiLabel": {
      "type": "string"
    },
    "deliverables": {
      "type": "json"
    },
    "tags": {
      "type": "json"
    },
    "customUrl": {
      "type": "string"
    }
  }
}
