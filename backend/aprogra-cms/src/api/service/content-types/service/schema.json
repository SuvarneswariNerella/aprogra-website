{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service Page Feature Deep-Dive",
    "description": "Dynamic engineering disciplines, tabs, and feature showcase on the Services page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "tabLabel": {
      "type": "string",
      "default": "Discipline"
    },
    "title": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "string",
      "default": "Core Engineering"
    },
    "subheading": {
      "type": "string"
    },
    "shortSummary": {
      "type": "text"
    },
    "description": {
      "type": "text"
    },
    "icon": {
      "type": "enumeration",
      "enum": [
        "web",
        "ai",
        "saas",
        "design",
        "cloud",
        "mobile",
        "security",
        "database",
        "sparkles"
      ],
      "default": "web"
    },
    "iconMedia": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "accentColor": {
      "type": "string",
      "default": "#3B82F6"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "imageUrl": {
      "type": "string"
    },
    "cardOrder": {
      "type": "integer",
      "default": 1
    },
    "kpiNumber": {
      "type": "string"
    },
    "kpiLabel": {
      "type": "string"
    },
    "deliverables": {
      "type": "component",
      "repeatable": true,
      "component": "elements.deliverable-item"
    },
    "tags": {
      "type": "component",
      "repeatable": true,
      "component": "elements.tech-tag"
    },
    "customUrl": {
      "type": "string"
    }
  }
}
