    "primaryValue": {
      "type": "string",
      "required": true
    },
    "subtext": {
      "type": "text"
    },
    "buttonText": {
      "type": "string"
    },
    "buttonUrl": {
      "type": "string"
    },
    "iconName": {
      "type": "string",
      "default": "mail"
    },
    "iconMedia": {
      "type": "media",
      "multiple": false,
      "required": false,
