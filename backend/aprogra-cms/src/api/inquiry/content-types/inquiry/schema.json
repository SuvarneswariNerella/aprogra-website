{
  "kind": "collectionType",
  "collectionName": "inquiries",
  "info": {
    "singularName": "inquiry",
    "pluralName": "inquiries",
    "displayName": "Inquiry",
    "description": "Client project briefs, contact messages, and intro call bookings"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "company": {
      "type": "string"
    },
    "capabilities": {
      "type": "json"
    },
    "budget": {
      "type": "string"
    },
    "timeline": {
      "type": "string"
    },
    "message": {
      "type": "text",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "project_brief",
        "intro_call"
      ],
      "default": "project_brief"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "new",
        "in_review",
        "contacted",
        "archived"
      ],
      "default": "new"
    },
    "metadata": {
      "type": "json"
    }
  }
}
