{
  "kind": "collectionType",
  "collectionName": "team_members",
  "info": {
    "singularName": "team-member",
    "pluralName": "team-members",
    "displayName": "Team Member",
    "description": "Leadership and architect profiles for interactive photo stack"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "role": {
      "type": "string",
      "required": true
    },
    "bio": {
      "type": "text",
      "required": true
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "photoUrl": {
      "type": "string",
      "description": "Direct image URL fallback"
    },
    "skills": {
      "type": "string",
      "description": "Comma-separated skills (e.g. Cloud Arch, Distributed Systems, Rust & Go)"
    },
    "linkedinUrl": {
      "type": "string"
    },
    "githubUrl": {
      "type": "string"
    },
    "twitterUrl": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
