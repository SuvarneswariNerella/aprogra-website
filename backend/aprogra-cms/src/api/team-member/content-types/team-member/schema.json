{
  "kind": "collectionType",
  "collectionName": "team_members",
  "info": {
    "singularName": "team-member",
    "pluralName": "team-members",
    "displayName": "Team Member",
    "description": "Team member profile for the About page meet-the-team section"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "role": {
      "type": "string",
      "required": true
    },
    "bio": {
      "type": "text",
      "required": true
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "skills": {
      "type": "component",
      "repeatable": true,
      "component": "elements.team-skill"
    },
    "linkedinUrl": {
      "type": "string"
    },
    "githubUrl": {
      "type": "string"
    },
    "twitterUrl": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "default": 1
    }
  }
}
