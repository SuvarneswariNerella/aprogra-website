{
  "kind": "collectionType",
  "collectionName": "contact_inquiries",
  "info": {
    "singularName": "contact-inquiry",
    "pluralName": "contact-inquiries",
    "displayName": "Contact Inquiries & Briefs",
    "description": "Incoming project briefs, client inquiries, and scheduled intro calls"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "string",
      "required": true
    },
    "company": {
      "type": "string"
    },
    "capabilities": {
      "type": "json"
    },
    "budget": {
      "type": "string"
    },
    "timeline": {
      "type": "string"
    },
    "message": {
      "type": "text"
    },
    "inquiryType": {
      "type": "enumeration",
      "enum": ["brief", "call_booking"],
      "default": "brief"
    },
    "preferredTopic": {
      "type": "string"
    },
    "preferredTime": {
      "type": "string"
    },
    "status": {
      "type": "enumeration",
      "enum": ["new", "reviewed", "contacted", "closed"],
      "default": "new"
    }
  }
}
